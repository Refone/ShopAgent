# ============================================================
# ShopAgent 统一环境配置
# 复制为 .env 后按本地环境调整
# ============================================================

# ---------- 共享鉴权 ----------
# customer-service 与 ecommerce-service 共用同一套 JWT 配置
# 模板默认值开箱即用，仅供本地开发/演示；正式环境请替换为随机值
# （例如：openssl rand -hex 32）
JWT_SECRET=shopagent-dev-jwt-secret-please-change-me
JWT_ALGORITHM=HS256

# ---------- 共享 PostgreSQL ----------
# POSTGRES_PORT 为宿主机端口，compose 中的 postgres 容器会映射到此端口
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=18200
POSTGRES_USER=customer_service
# 模板默认值开箱即用，仅供本地开发/演示；正式环境请替换
POSTGRES_PASSWORD=shopagent-dev-postgres-password-please-change-me

# 各服务使用的数据库名（位于同一个 PostgreSQL 实例）
CUSTOMER_SERVICE_DB=customer_service
ECOMMERCE_SERVICE_DB=ecommerce

# ---------- customer-service ----------
CUSTOMER_SERVICE_HOST=127.0.0.1
CUSTOMER_SERVICE_PORT=18000

CONVERSATION_IDLE_TIMEOUT_SECONDS=600
MESSAGE_MERGE_DELAY_MS=1000
TURN_WORKER_PULL_INTERVAL_MS=2000

# 日志文件输出目录。支持两种写法：
#   1. 相对路径：基于项目顶层目录（即包含 .env 的目录），如 var/logs/customer-service
#   2. 绝对路径：如 /var/log/customer-service，也支持 ~/logs/customer-service
# 不配置或留空时默认：项目顶层目录/var/logs/customer-service
# 日志按天写入 <YYYY-MM-DD>.log，例如 2026-11-21.log。
CUSTOMER_SERVICE_LOG_DIR=var/logs/customer-service
# 绝对路径示例（按需取消注释并替换上面的相对路径）：
# CUSTOMER_SERVICE_LOG_DIR=/var/log/customer-service

# 日志级别阈值，可选值（不区分大小写，debug 等同于 DEBUG）：
#   DEBUG ｜ INFO ｜ WARNING ｜ ERROR ｜ CRITICAL
# 只有级别不低于阈值的日志才会输出到对应通道：
# 1. 文件通道
#    CUSTOMER_SERVICE_LOG_FILE_LEVEL：文件通道，默认 DEBUG（记录全部级别）
# 2. 串口（控制台）通道
#    CUSTOMER_SERVICE_LOG_CONSOLE_LEVEL：串口（控制台）通道，默认 INFO（不输出 DEBUG）
CUSTOMER_SERVICE_LOG_FILE_LEVEL=DEBUG
CUSTOMER_SERVICE_LOG_CONSOLE_LEVEL=INFO

# 日志文件保留天数，默认 3。按自然日保留最近 N 天（含当天）；
# 服务启动和跨天切换日志文件时，会清理更早的 <YYYY-MM-DD>.log 文件。
CUSTOMER_SERVICE_LOG_RETENTION_DAYS=3

# ---------- 依赖源（可选） ----------
# 构建和安装 Python 依赖时使用的 PyPI 镜像站点（只填域名，不含协议和路径）。
# 默认 mirrors.aliyun.com（公网可达，本地开发可直接构建）。
# 腾讯云服务器建议改为 mirrors.tencentyun.com：它解析到内网 169.254.0.3，
# 实测 4-7 MB/s，且内网流量不计公网带宽；但该地址仅在腾讯云内可达。
# PIP_MIRROR_HOST=mirrors.aliyun.com

# ---------- ecommerce-service ----------
ECOMMERCE_SERVICE_HOST=127.0.0.1
# 宿主机端口（app 容器内的服务端口固定为 8001）
ECOMMERCE_SERVICE_PORT=18001
# Redis 容器映射到宿主机的端口
REDIS_PORT=18201

# ---------- ai-service ----------
# 预留配置，当前 ai-service 尚未实现
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=18002

# ---------- frontend ----------
# 前端服务的监听地址与端口。Vite 的开发服务器和预览服务器读取这里的配置，
# 后端 CORS 白名单也由这两组地址自动派生（无需再单独配置 CORS_ORIGINS）。
USER_FRONTEND_HOST=127.0.0.1
USER_FRONTEND_PORT=18100
ADMIN_FRONTEND_HOST=127.0.0.1
ADMIN_FRONTEND_PORT=18101
