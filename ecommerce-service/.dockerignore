# Local virtualenv: contains macOS binaries and would overwrite /app/.venv in the image
.venv/
venv/

# Python caches
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Local secrets and env files (compose injects the real values)
.env
.env.*
!.env.example

# Local tooling / OS noise
.git/
.gitignore
.vscode/
.idea/
.DS_Store
*.log
