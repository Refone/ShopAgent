{
  "folders": [
    {
      "path": ".",
    },
    {
      "path": "ecommerce-service",
    },
    {
      "path": "customer-service",
    },
    {
      "path": "ai-service",
    },
  ],
  "settings": {
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,

    "files.exclude": {
      "**/.pytest_cache": true,
      "**/__pycache__": true,
      "**/.venv": true,
      "**/.ruff_cache": true,
      "**/node_modules": true,
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/.jj": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
    },

    "python.analysis.extraPaths": [
      "${workspaceFolder:ecommerce-service}",
      "${workspaceFolder:customer-service}",
      "${workspaceFolder:ai-service}",
    ],
    "python.analysis.autoImportCompletions": true,

    "terminal.integrated.env.osx": {
      "PYTHONPATH": "${workspaceFolder:ecommerce-service}:${workspaceFolder:customer-service}:${workspaceFolder:ai-service}",
    },

    "[python]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "charliermarsh.ruff", // 指定 Ruff 为默认格式化器

      "editor.codeActionsOnSave": {
        "source.fixAll.ruff": "explicit", // 自动修复所有可修复的 lint 问题
        "source.organizeImports.ruff": "explicit", // 整理 import 语句
      },
    },

    "workbench.colorCustomizations": {
      "titleBar.activeBackground": "#604040",
      "titleBar.inactiveBackground": "#604040",
      "statusBar.background": "#503030",
      "statusBar.inactiveBackground": "#503030",
    },
  },
}
